# Copy to  outreach/.env  and fill in. NEVER commit the real .env (it's gitignored).
# These match your Hostinger settings.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=partnerships@playplate.in
SMTP_PASS=your-mailbox-password-here      # the partnerships@playplate.in mailbox password

FROM_NAME=PLAYPLATE Partnerships

# Link used for {{video_url}} in templates. Host the 11 MB brand video somewhere
# (YouTube unlisted, Google Drive, or your site) and paste the link here — do NOT
# attach the video to every email (kills deliverability).
VIDEO_URL=https://www.instagram.com/playplate.foods
