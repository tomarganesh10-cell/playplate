# ============================================================
# Playplate AI Social Media Manager — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ─── App ──────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
DEBUG=false
DOMAIN=social.playplate.in
ADMIN_EMAIL=admin@playplate.in

# ─── Database ─────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_STRONG_REDIS_PASSWORD

# ─── MinIO Storage ────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET

# ─── n8n ──────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=CHANGE_THIS_N8N_PASSWORD

# ─── AI APIs (add via Admin → Credentials) ────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ─── Image Generation ─────────────────────────────────────
STABILITY_API_KEY=sk-...

# ─── Video Generation ─────────────────────────────────────
KLING_API_KEY=
RUNWAY_API_KEY=
PIKA_API_KEY=
HAILUO_API_KEY=
GOOGLE_VEO_API_KEY=

# ─── Google APIs ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Meta (Instagram + Facebook) ──────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
FACEBOOK_PAGE_ID=

# ─── LinkedIn ─────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=

# ─── YouTube ──────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ─── Google Business Profile ──────────────────────────────
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# ─── WhatsApp ─────────────────────────────────────────────
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=
DOCTOR_WHATSAPP=+919876543210

# ─── Email (SendGrid preferred) ───────────────────────────
SENDGRID_API_KEY=SG.xxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@social.playplate.in
DOCTOR_EMAIL=dr.anshu@chandigarhdentist.com

# ─── Client Info ──────────────────────────────────────────
CLIENT_NAME=Dr. Anshu Gupta
CLIENT_WEBSITE=https://www.chandigarhdentist.com
CLIENT_LOCATION=Chandigarh, India
