# =============================================================================
# Trading Playplate — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env.
# =============================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=production                 # development | staging | production
DOMAIN=trading.playplate.in
LOG_LEVEL=INFO

# --- Trading safety (defaults are SAFE) --------------------------------------
# simulation | paper | live   (default paper; live needs ALLOW_LIVE_TRADING)
TRADING_MODE=paper
# Master kill-switch for live order routing. Must be `true` AND TRADING_MODE=live.
ALLOW_LIVE_TRADING=false
# Require an explicit confirmation token on every live order.
REQUIRE_ORDER_CONFIRMATION=true

# --- Backend -----------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins allowed by CORS.
CORS_ORIGINS=https://trading.playplate.in,http://localhost:8080

# --- Security ----------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet key for encrypting broker API secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_fernet_key
# Per-IP request budget (requests / window-seconds)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ----------------------------------------------------------------
POSTGRES_USER=playplate
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=playplate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Assembled by config.py if left blank:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db

# --- Zerodha Kite Connect ----------------------------------------------------
# https://developers.kite.trade/
KITE_API_KEY=
KITE_API_SECRET=
# Access token is generated daily via the login flow and stored encrypted.
# Leave blank; populate through the /api/broker/session endpoint.
KITE_ACCESS_TOKEN=

# --- AI layer (Anthropic Claude) ---------------------------------------------
ANTHROPIC_API_KEY=
# Latest, most capable model recommended for explanations/reports.
AI_MODEL=claude-opus-4-8
AI_ENABLED=true

# --- Telegram notifications --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATIONS_ENABLED=true

# --- Risk management defaults ------------------------------------------------
RISK_MAX_DAILY_LOSS=5000              # absolute INR loss that halts trading
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_EXPOSURE=200000              # max gross exposure INR
RISK_PER_TRADE_PCT=1.0                # % of capital risked per trade
RISK_MAX_DRAWDOWN_PCT=10.0            # halts trading if breached
ACCOUNT_CAPITAL=200000

# --- Monitoring --------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# --- Frontend (build-time) ---------------------------------------------------
VITE_API_BASE_URL=/api
